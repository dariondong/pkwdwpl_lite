# 本地发布签名配置示例。
#
# 用法：
#   1. 生成 keystore（无需 JDK）：
#        python3 tool/gen_keystore.py --out android/keystore/release.keystore
#      或者用 keytool：
#        keytool -genkeypair -v -keystore android/keystore/release.keystore -storetype PKCS12 \
#          -keyalg RSA -keysize 2048 -validity 10000 -alias pkwdwpl \
#          -storepass '你的密码' -keypass '你的密码' \
#          -dname "CN=BG7LZQ, OU=Amateur Radio, O=PKWDWPL Lite, C=CN"
#   2. 复制本文件为 android/key.properties 并填入下面的值
#
# ⚠️ android/key.properties 与 android/keystore/ 都已被 .gitignore 忽略，不会进仓库。
#
# CI（GitHub Actions）不使用本文件，而是从 Secrets 生成：
#   ANDROID_KEYSTORE_BASE64 / ANDROID_KEYSTORE_PASSWORD（/ ANDROID_KEY_ALIAS 可选）
# 详见 .github/workflows/release.yml 与 README 的「签名配置」章节。

storePassword=你的store密码
keyPassword=你的key密码
keyAlias=pkwdwpl
# 路径相对于 android/ 目录（与 APRSLocus 的写法一致）
storeFile=keystore/release.keystore

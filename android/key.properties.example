# 本地发布签名配置示例。
#
# 用法：
#   1. cp android/key.properties.example android/key.properties
#   2. 按下面格式填入你自己的信息（key.properties 已被 .gitignore 忽略，不会进仓库）
#
# CI（GitHub Actions）不使用本文件，而是用环境变量：
#   SIGNING_KEY / KEY_ALIAS / KEY_PASSWORD / STORE_PASSWORD
#
# 生成 keystore（一次性）：
#   keytool -genkeypair -v -keystore release.jks -storetype JKS \
#     -keyalg RSA -keysize 2048 -validity 10000 \
#     -alias pkwdwpl -storepass '你的store密码' -keypass '你的key密码' \
#     -dname "CN=BG7LZQ, OU=Ham, O=PKWDWPL Lite, L=Guangzhou, ST=Guangdong, C=CN"
#
# 生成 Base64（用于 GitHub Secret SIGNING_KEY）：
#   base64 -w 0 release.jks > release.jks.base64     # Linux
#   base64 -i release.jks | pbcopy                   # macOS
# 或者直接用本仓库的脚本：bash tool/make_signing_key.sh release.jks
#
storePassword=你的store密码
keyPassword=你的key密码
keyAlias=pkwdwpl
# 相对 android/app/ 的路径（也可以写绝对路径）
storeFile=release.jks
